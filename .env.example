# 長文読解の生成と AI会話 に使います (単語・文法は事前生成DBのためキー不要)
# https://console.anthropic.com/settings/keys で発行
ANTHROPIC_API_KEY=

# --- 読解のレート制限 (ストア公開の前に必ず入れる) ---
# 無いと上限が効かず、費用の天井が Anthropic の残高そのものになる。
# Upstash を直接契約した場合はこの2つ。
# Vercel のダッシュボードから足した場合は KV_REST_API_URL / KV_REST_API_TOKEN でもよい
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1日あたりの上限 (省略時は 全体100 / IP40 / トークン20)。
# 1本あたり $0.10〜0.20 の見積もりなので、全体100本で約 $10〜20/日 が上限になる
# READING_LIMIT_GLOBAL=100
# READING_LIMIT_IP=40
# READING_LIMIT_TOKEN=20
